PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/brightmind_publishing
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
PAYSTACK_MOCK_MODE=true
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# RunPod Pod HTTPS proxy root (no /chat suffix), with matching bearer token.
# Server only; never use VITE_*.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
AI_CHAT_API_FORMAT=native
# RunPod configuration: ../ai-service/RUNPOD.md.
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=5
AI_MAX_CONCURRENT_REQUESTS=2
# Native messages/reply API on the RunPod GPU Pod.
AI_CHAT_TIMEOUT_MS=135000

# Speech uses AI_SERVICE_URL and AI_SERVICE_TOKEN by default. Set these only
# when speech runs on a separate service.
AI_ASR_SERVICE_URL=
AI_ASR_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=780000
AI_UPLOAD_TIMEOUT_MS=30000
AI_MAX_UPLOAD_BYTES=10485760

# Optional Word-to-PDF conversion. Install LibreOffice on the backend host.
# Leave unset to use its default install path; upload PDF for exact author layout.
# LIBREOFFICE_BIN=/usr/bin/libreoffice
