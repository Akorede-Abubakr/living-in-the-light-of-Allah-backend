{
  "name": "muslim-guardian-backend",
  "version": "1.0.0",
  "description": "Digital Publishing & Bookstore Backend REST API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node-dev --transpile-only src/scripts/seed.ts",
    "test:e2e": "ts-node-dev --transpile-only src/scripts/test-e2e.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
